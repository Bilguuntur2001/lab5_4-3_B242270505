{
  "info": {
    "name": "Lab05 — Хичээлд бүртгүүлэх API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "S01 Идэвхтэй, урьдач хангасан оюутан бүртгүүлэхэд 201 OK",
      "item": [
        {
          "name": "setup: PUT /students/B_S01",
          "event": [],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"status\":\"active\",\"coursesTaken\":[\"CS201\"]}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/students/B_S01",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "students",
                "B_S01"
              ]
            }
          }
        },
        {
          "name": "setup: PUT /courses/CS313_S01",
          "event": [],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"prerequisites\":[\"CS201\"]}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/courses/CS313_S01",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "courses",
                "CS313_S01"
              ]
            }
          }
        },
        {
          "name": "POST /registrations",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"result = OK\", () => pm.expect(pm.response.json().result).to.eql(\"OK\"));",
                  "pm.test(\"registrationID нь эерэг тоо\", () => { const id = pm.response.json().registrationID; pm.expect(id).to.be.a(\"number\"); pm.expect(id).to.be.above(0); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"studentID\":\"B_S01\",\"courseID\":\"CS313_S01\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/registrations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "registrations"
              ]
            }
          }
        }
      ]
    },
